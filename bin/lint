#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# Build explicitly first: `docker compose run` only builds the image when
# it doesn't exist yet, so a source edit with no accompanying rebuild would
# otherwise run against the previous version of the code. Build chatter is
# redirected to stderr, matching bin/export.
docker compose build task 1>&2

exec docker compose run --rm task bundle exec rake lint
