# Environment for the frankmd service in docker-compose.yml.
# Copy to .env.frank and fill in the values. .env.frank is git-ignored.

# Rails secret used to sign cookies and sessions. Generate one with:
#   openssl rand -hex 64
SECRET_KEY_BASE=

# Host user and group that own _posts/, so files written by the editor
# keep your ownership. Find them with `id -u` and `id -g`.
UID=501
GID=20
